{
  "apphosting": [{
    "backendId": "kopiteh-web",
    "rootDir": "frontend",
    "ignore": ["node_modules", ".git", ".deployment-tools", ".env", ".env.*", "**/.env", "**/.env.*", "**/node_modules", "**/.next", "backend", "firebase-debug.log", "firebase-debug.*.log"]
  }],
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4001 }
  }
}
